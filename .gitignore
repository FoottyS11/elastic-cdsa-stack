# =============================================
# Git Ignore - Elastic + Splunk CDSA Stack
# =============================================

# Données persistantes (ne pas versionner)
data/
*.data

# Uploads
uploads/*
!uploads/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Logs locaux
logs/
*.log

# Fichiers temporaires
*.tmp
*.temp
*.swp
*.swo
*~

# Fichiers système
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Backup files
*.bak
*.backup

# Certificats SSL (si vous en générez)
certs/
*.pem
*.key
*.crt
*.p12

# Docker
.docker/
